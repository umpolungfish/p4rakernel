info: Imscribing/YangMills/ContinuumClosure.lean:1384:0: YangMills.unconditional_uniform_rescaled_lattice_mass_gap_and_rg_convergence (N : ℕ) (hN : 2 ≤ N) :
  ∃ D,
    (0 < (YangMills.concreteUniformRGTrajectory N hN).Δ₀ ∧
        (∀ (m : ℕ),
            (YangMills.concreteUniformRGTrajectory N hN).Δ₀ ≤
              (YangMills.concreteUniformRGTrajectory N hN).Δ_latt m /
                (YangMills.concreteUniformRGTrajectory N hN).a_seq m) ∧
          (YangMills.concreteUniformRGTrajectory N hN).Δ₀ ≤ (YangMills.concreteUniformRGTrajectory N hN).F.Δ_phys) ∧
      (0 < (YangMills.concreteUniformRGTrajectory N hN).F.Δ_phys ∧
          Filter.Tendsto
              (fun m ↦
                (YangMills.concreteUniformRGTrajectory N hN).Δ_latt m /
                  (YangMills.concreteUniformRGTrajectory N hN).a_seq m)
              Filter.atTop (nhds (YangMills.concreteUniformRGTrajectory N hN).F.Δ_phys) ∧
            Filter.Tendsto
              (fun m ↦
                (1 -
                    rexp
                      (-((YangMills.concreteUniformRGTrajectory N hN).F.Δ_phys *
                          (YangMills.concreteUniformRGTrajectory N hN).a_seq m))) /
                  (YangMills.concreteUniformRGTrajectory N hN).a_seq m)
              Filter.atTop (nhds (YangMills.concreteUniformRGTrajectory N hN).F.Δ_phys)) ∧
        (Filter.Tendsto D.ξ_seq Filter.atTop Filter.atTop ∧
            ∀ (x : D.trilattice.S), D.trilattice.μ (D.trilattice.δ x) = x) ∧
          ((∀ (β : ℝ), Filter.Tendsto (D.Z β) Filter.atTop Filter.atTop) ∧ ∀ (ψ : D.H_q), 0 ≤ (⟪ψ, D.H_op ψ⟫_ℂ).re) ∧
            ((∀ (i : D.SymmIdx), YangMills.lieBracketCLM (D.symm i) D.H_op = 0) ∧
                D.Ω_q ∈ YangMills.invarianceSet D.symm ∧
                  (∀ (i : Fin D.n_dof) (z : YangMills.PhaseSpace D.n_dof),
                      YangMills.poissonBracket (YangMills.coordQ i) (YangMills.coordP i) z ≠ 0) ∧
                    (∀ (f : YangMills.PhaseSpace D.n_dof → ℝ) (z : YangMills.PhaseSpace D.n_dof),
                        Differentiable ℝ f →
                          (∀ (w : YangMills.PhaseSpace D.n_dof), YangMills.poissonBracket f D.H_cl w = 0) →
                            ∀ (t : ℝ), f (D.flow.Φ t z) = f z) ∧
                      ∀ (A₁ A₂ B₁ B₂ : D.Obs), A₁ ⊗ₜ[ℂ] B₁ * A₂ ⊗ₜ[ℂ] B₂ = (A₁ * A₂) ⊗ₜ[ℂ] (B₁ * B₂)) ∧
              (∀ (z : YangMills.PhaseSpace 1),
                  YangMills.singleDOFProj D.n_dof (YangMills.singleDOFLift D.n_dof z) = z) ∧
                0 < D.action_val
