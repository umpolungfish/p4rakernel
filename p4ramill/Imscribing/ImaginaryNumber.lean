  List.map deltaF ls
def muList (ps : List (Prop × Prop)) : List Prop :=
  List.map muF ps
theorem frobenius_list (ls : List Prop) : muList (deltaList ls) = ls := by
  induction ls with
  | nil => rfl
  | cons f rest ih => simpa [deltaList, muList, deltaF, muF] using congrArg (f :: ·) ih

