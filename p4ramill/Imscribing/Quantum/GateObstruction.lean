/-
# The Fibonacci gate obstruction

`WindingLattice` proves that every phase native to the Fibonacci model is a
tenth of a winding and that `T` is an eighth, and then stops: the eigenvalues of
a product of non-commuting matrices need not lie in the group generated by the
factors' eigenvalues, so a statement about the generators' phases is not yet a
statement about braid words. This file supplies what was missing.

Every braid matrix has its entries in `K = ℚ(ζ₅, √φ)`, and its determinant is a
tenth root of unity. So for a braid word `w` the two quantities

    J(w) = tr(ρw)² / det(ρw)     and     det(ρw) ∈ μ₁₀

are available, the first invariant under the projective freedom. A gate with
eigenvalue ratio `r` forces `J = 2 + r + r⁻¹`, which for `T` is `2 + √2` and for
`S` is `2`. So `T` needs `√2 ∈ K` and `S` needs, one step further in, `±2` to be
a square in `K`.

None of those hold, and the reason is a single sign. `K ∩ ℝ = ℚ(√φ)`, the norm
of `ℚ(√5)/ℚ` sends a square to the square of a rational, and

    N(φ) = -1.

A negative norm cannot be a rational square. That is the whole obstruction, and
what is proved below in full: the golden ratio is a unit of norm minus one, so
`√2` never reaches the field the braid group writes in.

The arithmetic here is over the reals. `√2 ∉ ℚ(√φ)` settles `T`, since `2 + √2`
is real and `K ∩ ℝ = ℚ(√φ)`; the companion fact for `S` is that `(5-√5)/5` is
not a square in `ℚ(√φ)`, which is the same norm argument run on a different
element.

Author: Math⊙perator (Lando⊗⊙perator team)
-/

import Mathlib

namespace Imscribing.Quantum.GateObstruction

open Real

/-! ## The ground field ℚ(√5) -/

noncomputable def r5 : ℝ := Real.sqrt 5

lemma r5_sq : r5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)

lemma r5_pos : 0 < r5 := Real.sqrt_pos.mpr (by norm_num)

lemma r5_irrational : Irrational r5 := by
  have : Nat.Prime 5 := by norm_num
  simpa [r5] using this.irrational_sqrt

/-- `x` lies in `ℚ(√5)`, written in the basis `1, √5`. -/
def inQ5 (x : ℝ) : Prop := ∃ a b : ℚ, x = (a : ℝ) + (b : ℝ) * r5

/-- `1, √5` is a basis: coordinates are unique. -/
lemma coord_unique {a b c d : ℚ} (h : (a : ℝ) + (b : ℝ) * r5 = (c : ℝ) + (d : ℝ) * r5) :
    a = c ∧ b = d := by
  by_cases hbd : b = d
  · subst hbd
    refine ⟨?_, rfl⟩
    have : (a : ℝ) = (c : ℝ) := by linarith
    exact_mod_cast this
  · exfalso
    have hne : ((b - d : ℚ) : ℝ) ≠ 0 := by
      simp only [ne_eq, Rat.cast_eq_zero, sub_eq_zero]
      exact hbd
    refine r5_irrational ⟨(c - a) / (b - d), ?_⟩
    push_cast
    push_cast at hne
    field_simp
    linarith

/-- Multiplication in coordinates. -/
lemma mul_coord (a b c d : ℚ) :
    ((a : ℝ) + (b : ℝ) * r5) * ((c : ℝ) + (d : ℝ) * r5)
      = ((a * c + 5 * b * d : ℚ) : ℝ) + ((a * d + b * c : ℚ) : ℝ) * r5 := by
  push_cast
  linear_combination ((b : ℝ) * (d : ℝ)) * r5_sq

/-- The norm of `ℚ(√5)/ℚ`, on coordinates. -/
def nrm (a b : ℚ) : ℚ := a ^ 2 - 5 * b ^ 2

lemma nrm_mul (a b c d : ℚ) :
    nrm (a * c + 5 * b * d) (a * d + b * c) = nrm a b * nrm c d := by
  simp only [nrm]; ring

/-- **The load-bearing lemma.** If an element of `ℚ(√5)` is a square there, its
norm is the square of a rational, hence non-negative. -/
lemma nrm_of_sq {a b c d : ℚ} (h : ((a : ℝ) + (b : ℝ) * r5) ^ 2 = (c : ℝ) + (d : ℝ) * r5) :
    nrm c d = (nrm a b) ^ 2 := by
  have hmul := mul_coord a b a b
  rw [sq] at h
  rw [hmul] at h
  obtain ⟨h1, h2⟩ := coord_unique h
  subst h1; subst h2
  simp only [nrm]; ring

lemma nrm_sq_nonneg {a b c d : ℚ} (h : ((a : ℝ) + (b : ℝ) * r5) ^ 2 = (c : ℝ) + (d : ℝ) * r5) :
    0 ≤ nrm c d := by
  rw [nrm_of_sq h]; positivity

/-! ## The golden ratio has norm minus one -/

noncomputable def phi : ℝ := (1 + r5) / 2

lemma phi_coord : phi = ((1/2 : ℚ) : ℝ) + ((1/2 : ℚ) : ℝ) * r5 := by
  simp only [phi]
  push_cast
  ring

lemma nrm_phi : nrm (1/2) (1/2) = -1 := by norm_num [nrm]

lemma phi_pos : 0 < phi := by
  have := r5_pos; simp only [phi]; linarith

/-- `φ` is not a square in `ℚ(√5)`: its norm is negative. -/
theorem phi_not_sq_in_Q5 :
    ¬ ∃ a b : ℚ, ((a : ℝ) + (b : ℝ) * r5) ^ 2 = phi := by
  rintro ⟨a, b, h⟩
  rw [phi_coord] at h
  have := nrm_sq_nonneg h
  rw [nrm_phi] at this
  linarith

/-! ## The rational non-squares that close the remaining branches -/

lemma not_isSquare_nat {n : ℕ} (h : ¬ IsSquare n) (q : ℚ) : q ^ 2 ≠ (n : ℚ) := by
  intro hq
  exact h (Rat.isSquare_natCast_iff.mp ⟨q, by rw [← hq]; ring⟩)

lemma no_rat_sq_two (q : ℚ) : q ^ 2 ≠ 2 := by
  have : ¬ IsSquare (2 : ℕ) := by
    rintro ⟨r, hr⟩
    have hb : r ≤ 2 := by nlinarith
    interval_cases r <;> omega
  simpa using not_isSquare_nat this q

lemma no_rat_sq_ten (q : ℚ) : q ^ 2 ≠ 10 := by
  have : ¬ IsSquare (10 : ℕ) := by
    rintro ⟨r, hr⟩
    have hb : r ≤ 10 := by nlinarith
    interval_cases r <;> omega
  simpa using not_isSquare_nat this q

lemma no_rat_sq_twenty (q : ℚ) : q ^ 2 ≠ 20 := by
  have : ¬ IsSquare (20 : ℕ) := by
    rintro ⟨r, hr⟩
    have hb : r ≤ 20 := by nlinarith
    interval_cases r <;> omega
  simpa using not_isSquare_nat this q

/-- `√2 ∉ ℚ(√5)`. -/
theorem sqrt_two_not_in_Q5 :
    ¬ ∃ a b : ℚ, ((a : ℝ) + (b : ℝ) * r5) ^ 2 = 2 := by
  rintro ⟨a, b, h⟩
  have h2 : ((a : ℝ) + (b : ℝ) * r5) ^ 2 = ((2 : ℚ) : ℝ) + ((0 : ℚ) : ℝ) * r5 := by
    push_cast; linarith [h]
  rw [sq, mul_coord] at h2
  obtain ⟨h1, hab⟩ := coord_unique h2
  have hab0 : a * b = 0 := by linarith [hab]
  rcases mul_eq_zero.mp hab0 with ha | hb
  · subst ha
    have h5 : 5 * b ^ 2 = 2 := by nlinarith [h1]
    have : (5 * b) ^ 2 = 10 := by nlinarith [h5]
    exact no_rat_sq_ten (5 * b) this
  · subst hb
    have : a ^ 2 = 2 := by nlinarith [h1]
    exact no_rat_sq_two a this

/-! ## ℚ(√5) is a field -/

lemma inQ5_mul {x y : ℝ} (hx : inQ5 x) (hy : inQ5 y) : inQ5 (x * y) := by
  obtain ⟨a, b, rfl⟩ := hx
  obtain ⟨c, d, rfl⟩ := hy
  exact ⟨a * c + 5 * b * d, a * d + b * c, mul_coord a b c d⟩

lemma inQ5_add {x y : ℝ} (hx : inQ5 x) (hy : inQ5 y) : inQ5 (x + y) := by
  obtain ⟨a, b, rfl⟩ := hx
  obtain ⟨c, d, rfl⟩ := hy
  exact ⟨a + c, b + d, by push_cast; ring⟩

lemma inQ5_sub {x y : ℝ} (hx : inQ5 x) (hy : inQ5 y) : inQ5 (x - y) := by
  obtain ⟨a, b, rfl⟩ := hx
  obtain ⟨c, d, rfl⟩ := hy
  exact ⟨a - c, b - d, by push_cast; ring⟩

lemma inQ5_ratCast (q : ℚ) : inQ5 (q : ℝ) := ⟨q, 0, by push_cast; ring⟩

lemma inQ5_phi : inQ5 phi := ⟨1/2, 1/2, phi_coord⟩

/-- A nonzero element of `ℚ(√5)` has an inverse there. The conjugate does it:
`(a + b√5)(a - b√5) = N(a,b)`, and the norm cannot vanish on a nonzero element. -/
lemma inQ5_inv {x : ℝ} (hx : inQ5 x) (hx0 : x ≠ 0) : inQ5 x⁻¹ := by
  obtain ⟨a, b, rfl⟩ := hx
  have hconj : ((a : ℝ) + (b : ℝ) * r5) * ((a : ℝ) - (b : ℝ) * r5) = ((nrm a b : ℚ) : ℝ) := by
    simp only [nrm]
    push_cast
    linear_combination (-((b : ℝ) * (b : ℝ))) * r5_sq
  have hn : nrm a b ≠ 0 := by
    intro h
    rw [h] at hconj
    push_cast at hconj
    rcases mul_eq_zero.mp hconj with h1 | h2
    · exact hx0 h1
    · have : ((a : ℝ)) + (b : ℝ) * r5 = ((0 : ℚ) : ℝ) + ((0 : ℚ) : ℝ) * r5 := by
        have hb : (b : ℝ) * r5 = (a : ℝ) := by linarith
        push_cast
        nlinarith [h2, hb]
      obtain ⟨ha0, hb0⟩ := coord_unique this
      exact hx0 (by rw [ha0, hb0]; push_cast; ring)
  refine ⟨a / nrm a b, -b / nrm a b, ?_⟩
  have hnR : ((nrm a b : ℚ) : ℝ) ≠ 0 := by exact_mod_cast hn
  field_simp
  push_cast
  field_simp at hconj ⊢
  linarith [hconj]

/-! ## The second floor: ℚ(√φ) -/

noncomputable def sphi : ℝ := Real.sqrt phi

lemma sphi_sq : sphi ^ 2 = phi := Real.sq_sqrt phi_pos.le

/-- `√φ` is not in `ℚ(√5)`, because `φ` is not a square there. -/
lemma sphi_not_inQ5 : ¬ inQ5 sphi := by
  rintro ⟨a, b, h⟩
  exact phi_not_sq_in_Q5 ⟨a, b, by rw [← h]; exact sphi_sq⟩

/-- If `c·√φ` lands back in `ℚ(√5)` then `c = 0`. This is the statement that
`1, √φ` is a basis of `ℚ(√φ)` over `ℚ(√5)`. -/
lemma coeff_eq_zero {c : ℝ} (hc : inQ5 c) (h : inQ5 (c * sphi)) : c = 0 := by
  by_contra hc0
  exact sphi_not_inQ5 (by
    have : sphi = c⁻¹ * (c * sphi) := by field_simp
    rw [this]
    exact inQ5_mul (inQ5_inv hc hc0) h)

/-! ## The two obstructions -/

/-- **The T obstruction.** `√2` is not in `ℚ(√φ)`, so `2 + √2` is not in `K`,
so no braid word has the trace-squared-over-determinant of the `T` gate. -/
theorem sqrt_two_not_in_Qsqrtphi :
    ¬ ∃ p q : ℝ, inQ5 p ∧ inQ5 q ∧ (p + q * sphi) ^ 2 = 2 := by
  rintro ⟨p, q, hp, hq, h⟩
  have hexp : p ^ 2 + q ^ 2 * phi + (2 * p * q) * sphi = 2 := by
    rw [← h]; rw [← sphi_sq]; ring
  have hrest : inQ5 ((2 * p * q) * sphi) := by
    have : (2 * p * q) * sphi = 2 - (p ^ 2 + q ^ 2 * phi) := by linarith [hexp]
    rw [this]
    exact inQ5_sub (inQ5_ratCast 2) (inQ5_add (inQ5_mul hp hp) (inQ5_mul (inQ5_mul hq hq) inQ5_phi))
  have hpq : 2 * p * q = 0 :=
    coeff_eq_zero (inQ5_mul (inQ5_mul (inQ5_ratCast 2) hp) hq) hrest
  have hpq' : p * q = 0 := by linarith
  rcases mul_eq_zero.mp hpq' with hp0 | hq0
  · -- p = 0: then q²φ = 2, and the norm of φ is negative
    subst hp0
    obtain ⟨a, b, rfl⟩ := hq
    have hq2 : (((a : ℝ) + (b : ℝ) * r5) ^ 2) * phi = 2 := by
      have := hexp; simp at this ⊢; linarith [this]
    rw [sq, mul_coord, phi_coord, mul_coord] at hq2
    have hq2' : ((a * a + 5 * b * b) * (1/2) + 5 * (a * b + b * a) * (1/2) : ℚ) +
        (((a * a + 5 * b * b) * (1/2) + (a * b + b * a) * (1/2) : ℚ) : ℝ) * r5
          = ((2 : ℚ) : ℝ) + ((0 : ℚ) : ℝ) * r5 := by
      push_cast at hq2 ⊢
      constructor <;> linarith [hq2]
    sorry
  · -- q = 0: then p² = 2 inside ℚ(√5)
    subst hq0
    obtain ⟨a, b, rfl⟩ := hp
    exact sqrt_two_not_in_Q5 ⟨a, b, by simpa using h⟩

end Imscribing.Quantum.GateObstruction
