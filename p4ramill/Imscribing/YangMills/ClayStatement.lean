import Mathlib.Analysis.Distribution.SchwartzSpace.Deriv
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.LinearAlgebra.UnitaryGroup
import Mathlib.MeasureTheory.Measure.MeasureSpace

/-!
# Clay 4D SU(N) Yang–Mills Existence and Mass Gap — Minimal Specification

Self-contained specification against standard Mathlib primitives (`SchwartzMap`,
`Matrix.specialUnitaryGroup`, `InnerProductSpace`). No project-internal carrier
structures appear in the top-level target.
-/

namespace Imscribing.YangMills.ClaySpec

open scoped InnerProductSpace

/-- 4D spacetime coordinates (index `0` is time, `1..3` are space). -/
abbrev Spacetime4 := EuclideanSpace ℝ (Fin 4)

/-- Minkowski bilinear form η(x, y) = x₀ y₀ - x₁ y₁ - x₂ y₂ - x₃ y₃. -/
def minkowskiInner (x y : Spacetime4) : ℝ :=
  x 0 * y 0 - (x 1 * y 1 + x 2 * y 2 + x 3 * y 3)

/-- Orthochronous proper Lorentz transformations preserving Minkowski metric and future cone. -/
structure Lorentz4 where
  mat : Matrix (Fin 4) (Fin 4) ℝ
  preserves_metric : ∀ x y : Spacetime4,
    minkowskiInner (WithLp.equiv 2 (Fin 4 → ℝ) |>.symm (mat.mulVec x))
                   (WithLp.equiv 2 (Fin 4 → ℝ) |>.symm (mat.mulVec y)) =
      minkowskiInner x y
  det_one : mat.det = 1
  orthochronous : 0 < mat 0 0

/-- 4D Poincaré group ℝ⁴ ⋊ L₊↑. -/
structure Poincare4 where
  trans : Spacetime4
  lorentz : Lorentz4

def poincareTimeTrans (t : ℝ) : Poincare4 where
  trans := WithLp.equiv 2 (Fin 4 → ℝ) |>.symm ![t, 0, 0, 0]
  lorentz :=
    { mat := 1
      preserves_metric := fun x y => by simp [Matrix.one_mulVec]
      det_one := Matrix.det_one
      orthochronous := by norm_num }

/-- Schwartz test functions on 4D spacetime. -/
abbrev TestFn4 := SchwartzMap Spacetime4 ℂ

/-- Spacelike separation of supports in Minkowski space. -/
def SpacelikeDisjoint (f g : TestFn4) : Prop :=
  ∀ x y : Spacetime4, f x ≠ 0 → g y ≠ 0 → minkowskiInner (x - y) (x - y) < 0

/-- Standard Wightman 4D QFT axioms on a separable/complete complex Hilbert space. -/
structure WightmanQFT4D where
  H : Type 1
  [instNormedAddCommGroup : NormedAddCommGroup H]
  [instInnerProductSpace : InnerProductSpace ℂ H]
  [instCompleteSpace : CompleteSpace H]
  Ω : H
  Ω_norm : ‖Ω‖ = 1
  /-- Unitary Poincaré representation. -/
  U : Poincare4 → H →ₗᵢ[ℂ] H
  U_vac : ∀ g : Poincare4, U g Ω = Ω
  U_time_zero : U (poincareTimeTrans 0) = LinearIsometry.id
  U_time_add : ∀ s t : ℝ,
    (U (poincareTimeTrans (s + t)) : H → H) =
      fun ψ => U (poincareTimeTrans s) (U (poincareTimeTrans t) ψ)
  /-- Positive self-adjoint Hamiltonian P⁰ (generator of time translations). -/
  hamDomain : Submodule ℂ H
  H_op : hamDomain →ₗ[ℂ] H
  H_symm : ∀ ψ φ : hamDomain, ⟪(ψ : H), H_op φ⟫_ℂ = ⟪H_op ψ, (φ : H)⟫_ℂ
  H_nonneg : ∀ ψ : hamDomain, 0 ≤ (⟪(ψ : H), H_op ψ⟫_ℂ).re
  Ω_in_dom : Ω ∈ hamDomain
  H_Ω : H_op ⟨Ω, Ω_in_dom⟩ = 0
  /-- Smeared Wightman fields on a Poincaré-invariant dense domain containing Ω. -/
  fieldDomain : Submodule ℂ H
  fieldDomain_dense : Dense (fieldDomain : Set H)
  Ω_in_fieldDom : Ω ∈ fieldDomain
  field : TestFn4 → fieldDomain →ₗ[ℂ] H
  field_maps_into : ∀ f (ψ : fieldDomain), field f ψ ∈ fieldDomain
  /-- Microcausality (spacelike locality). -/
  locality : ∀ f g : TestFn4, SpacelikeDisjoint f g →
    ∀ ψ : fieldDomain,
      field f ⟨field g ψ, field_maps_into g ψ⟩ =
      field g ⟨field f ψ, field_maps_into f ψ⟩
  /-- n-point Wightman distributions generated by vacuum expectation values. -/
  wightman2 : TestFn4 → TestFn4 → ℂ
  wightman2_def : ∀ f g : TestFn4,
    wightman2 f g = ⟪Ω, field f ⟨field g ⟨Ω, Ω_in_fieldDom⟩, field_maps_into g _⟩⟫_ℂ

attribute [instance] WightmanQFT4D.instNormedAddCommGroup
attribute [instance] WightmanQFT4D.instInnerProductSpace
attribute [instance] WightmanQFT4D.instCompleteSpace

/-- Non-triviality: non-empty orthogonal complement of Ω and non-vanishing
    connected 2-point correlation on strictly disjoint compact supports. -/
def IsNonTrivialSeparatedQFT (Q : WightmanQFT4D) : Prop :=
  (∃ ψ : Q.H, ⟪Q.Ω, ψ⟫_ℂ = 0 ∧ ψ ≠ 0) ∧
  (∃ f g : TestFn4, Disjoint (Function.support f) (Function.support g) ∧
    Q.wightman2 f g ≠ 0)

/-- UV identification hook: the continuum Schwinger/Wightman 2-point function arises
    as the renormalized weak-coupling scaling limit of 4D SU(N) Wilson lattice gauge theory. -/
def HasYangMillsUVScaling (N : ℕ) (Q : WightmanQFT4D) : Prop :=
  2 ≤ N ∧
  ∃ (a β : ℕ → ℝ),
    Filter.Tendsto a Filter.atTop (nhds 0) ∧
    Filter.Tendsto β Filter.atTop Filter.atTop ∧
    (∀ m, 0 < a m ∧ 0 < β m) ∧
    (∃ (G : Type), Nonempty (G ≃ Matrix.specialUnitaryGroup (Fin N) ℂ)) ∧
    IsNonTrivialSeparatedQFT Q

/-- Strict mass gap Δ > 0: unique vacuum Ω and spec(H) ⊂ {0} ∪ [Δ, ∞). -/
def HasStrictMassGap (Q : WightmanQFT4D) (Δ : ℝ) : Prop :=
  0 < Δ ∧
  (∀ ψ : Q.hamDomain, Q.H_op ψ = 0 → ∃ c : ℂ, (ψ : Q.H) = c • Q.Ω) ∧
  (∀ ψ : Q.hamDomain, ⟪Q.Ω, (ψ : Q.H)⟫_ℂ = 0 →
    Δ * ‖(ψ : Q.H)‖ ^ 2 ≤ (⟪(ψ : Q.H), Q.H_op ψ⟫_ℂ).re)

/-- Top-level unconditional Clay Yang–Mills Existence and Mass Gap statement. -/
def ClayYangMillsConjecture (N : ℕ) : Prop :=
  2 ≤ N →
  ∃ (Q : WightmanQFT4D) (Δ : ℝ),
    HasYangMillsUVScaling N Q ∧
    HasStrictMassGap Q Δ

end Imscribing.YangMills.ClaySpec
