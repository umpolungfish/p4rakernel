/-
  Imscribing/YangMills/RademacherMulti.lean

  Multi-dimensional Rademacher annihilation on the compact cube.
  Strategy: Stone-Weierstrass approximates a continuous density by finite sums
  of coordinate-product functions; for those, Mathlib's Fubini product formula
  factors the integral, and the 1D annihilation kills any factor carrying r_K.
  Standard axioms only.
-/
import Mathlib
import Mathlib.Topology.ContinuousMap.StoneWeierstrass
import Mathlib.MeasureTheory.Integral.Pi
import Imscribing.YangMills.RademacherL1

set_option maxHeartbeats 8000000
set_option maxRecDepth 20000

open scoped BigOperators Topology ENNReal
open Complex Real Filter MeasureTheory Set ContinuousMap

namespace YangMills

abbrev I01 := {x : ℝ // x ∈ Set.Icc (0:ℝ) 1}

noncomputable def radI (K : ℕ) (x : I01) : ℝ := rademacher K x.1

noncomputable def clamp01 (x : ℝ) : I01 :=
  ⟨min (max x 0) 1, by
    constructor
    · exact le_min (le_max_right _ _) (by norm_num)
    · exact min_le_right _ _⟩

lemma continuous_insertNth (r : ℕ) (i : Fin (r+1)) (y : Fin r → I01) :
    Continuous (fun t : I01 => Fin.insertNth (α := fun _ => I01) i t y) := by
  apply continuous_pi
  intro j
  by_cases hji : j = i
  · subst j
    have hfun : (fun t : I01 => Fin.insertNth (α := fun _ => I01) i t y i) = fun t => t := by
      funext t; simp
    rw [hfun]; exact continuous_id
  · obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq hji
    subst j
    simpa using (continuous_const : Continuous (fun _ : I01 => y k))

lemma radI_annihilate (φ : C(I01, ℝ)) :
    Tendsto (fun K : ℕ => ∫ x : I01, φ x * radI K x ∂(volume : Measure I01)) atTop (𝓝 0) := by
  have hcont : Continuous (fun x : ℝ => (φ (clamp01 x) : ℝ)) := by
    unfold clamp01; fun_prop
  have hann := rademacher_annihilate_continuous (fun x : ℝ => (φ (clamp01 x) : ℝ)) hcont
  have hint : ∀ K : ℕ,
      (∫ x : I01, φ x * radI K x ∂(volume : Measure I01)) =
      ∫ x in Set.Ico (0:ℝ) 1, (φ (clamp01 x) : ℝ) * rademacher K x ∂volume := by
    intro K
    rw [show (volume : Measure I01) = Measure.comap Subtype.val (volume : Measure ℝ) from rfl]
    have hcongr : (fun x : ↥(Set.Icc (0:ℝ) 1) => φ x * radI K x) =
        fun x => (φ (clamp01 x.1) * rademacher K x.1) := by
      funext x
      have hc : clamp01 x.1 = x := by
        apply Subtype.ext
        change min (max x.1 0) 1 = x.1
        rw [max_eq_left x.2.1, min_eq_left x.2.2]
      rw [hc]; rfl
    rw [hcongr]
    rw [integral_subtype_comap (μ := (volume : Measure ℝ)) (s := Set.Icc (0:ℝ) 1)
      (f := fun y : ℝ => φ (clamp01 y) * rademacher K y) measurableSet_Icc]
    rw [← Measure.restrict_congr_set (Ico_ae_eq_Icc (μ := volume) (a := (0:ℝ)) (b := 1))]
  convert hann using 1
  funext K; exact hint K

end YangMills

namespace YangMills

/-- Coordinate projection on the cube Fin r → I01. -/
noncomputable def coordProj (r : ℕ) (j : Fin r) : C((Fin r → I01), ℝ) :=
  ⟨fun u => (u j).1, by fun_prop⟩

/-- Subalgebra generated by coordinate projections. -/
noncomputable def tensorSubalg (r : ℕ) : Subalgebra ℝ C((Fin r → I01), ℝ) :=
  Algebra.adjoin ℝ (Set.range (coordProj r))

lemma coordProj_separates (r : ℕ) : (tensorSubalg r).SeparatesPoints := by
  intro u v huv
  obtain ⟨j, hj⟩ : ∃ j, u j ≠ v j := by simpa [funext_iff] using huv
  refine ⟨coordProj r j, ?_, ?_⟩
  · refine ⟨coordProj r j, ?_, rfl⟩
    exact Algebra.subset_adjoin (R := ℝ) ⟨j, rfl⟩
  · change (u j).1 ≠ (v j).1
    intro h
    apply hj
    exact Subtype.ext h

lemma tensorSubalg_dense (r : ℕ) : (tensorSubalg r).topologicalClosure = ⊤ :=
  subalgebra_topologicalClosure_eq_top_of_separatesPoints (tensorSubalg r) (coordProj_separates r)

end YangMills

namespace YangMills

/-- I01Pi measure on Fin r → I01. -/
noncomputable def I01Pi (r : ℕ) : Measure (Fin r → I01) :=
  Measure.pi (fun _ : Fin r => (volume : Measure I01))

instance (r : ℕ) : SigmaFinite (volume : Measure I01) := inferInstance

instance (r : ℕ) : IsFiniteMeasure (I01Pi r) := ⟨by simp [I01Pi]⟩

lemma radI_measurable (K : ℕ) : Measurable (radI K) := by
  unfold radI
  exact (rademacher_measurable K).comp measurable_subtype_coe

/-- The product function ∏ j f_j(u_j) as a continuous map. -/
noncomputable def prodCM (r : ℕ) (f : Fin r → C(I01, ℝ)) : C((Fin r → I01), ℝ) :=
  ⟨fun u => ∏ j, f j (u j), by
    apply continuous_finset_prod
    intro j hj
    exact (f j).continuous.comp (continuous_apply j)⟩

/-- Integrability of q times a Rademacher product (bounded measurable, finite measure). -/
lemma integrable_radProd (r : ℕ) (S : Finset (Fin r)) (q : C((Fin r → I01), ℝ)) (K : ℕ) :
    Integrable (fun u : Fin r → I01 => q u * S.prod (fun j => radI K (u j))) (I01Pi r) := by
  have hmeas : AEStronglyMeasurable
      (fun u : Fin r → I01 => q u * S.prod (fun j => radI K (u j))) (I01Pi r) := by
    have hq : Measurable (fun u : Fin r → I01 => q u) := q.continuous.measurable
    have hprod : Measurable (fun u : Fin r → I01 => S.prod (fun j => radI K (u j))) := by
      exact Finset.measurable_prod S (fun j hj => (radI_measurable K).comp (measurable_pi_apply j))
    exact (hq.mul hprod).aestronglyMeasurable
  obtain ⟨C, hC⟩ := (isCompact_univ : IsCompact (Set.univ : Set (Fin r → I01))).exists_bound_of_continuousOn
      q.continuous.continuousOn
  refine Integrable.of_bound hmeas C ?_
  filter_upwards with u
  rw [norm_mul]
  have hrad : ‖S.prod (fun j => radI K (u j))‖ ≤ 1 := by
    calc
      ‖S.prod (fun j => radI K (u j))‖ ≤ S.prod (fun j => ‖radI K (u j)‖) :=
        Finset.norm_prod_le S (fun j => radI K (u j))
      _ ≤ 1 := by
        apply Finset.prod_le_one
        · intro j hj; positivity
        · intro j hj
          rw [Real.norm_eq_abs, radI, rademacher_abs]
  calc
    ‖q u‖ * ‖S.prod (fun j => radI K (u j))‖ ≤ ‖q u‖ * 1 :=
      mul_le_mul_of_nonneg_left hrad (norm_nonneg _)
    _ ≤ C := by simpa using hC u (by simp)

/-- Annihilation against a product of coordinate functions with Rademacher
factors at a nonempty set of coordinates. -/
private lemma product_annihilate (r : ℕ) (S : Finset (Fin r)) (hS : S.Nonempty)
    (f : Fin r → I01 → ℝ) (hcont : ∀ j, Continuous (f j)) :
    Tendsto (fun K : ℕ =>
      ∫ u : Fin r → I01, (∏ j, f j (u j)) * S.prod (fun j => radI K (u j)) ∂(I01Pi r))
      atTop (𝓝 0) := by
  classical
  obtain ⟨j0, hj0⟩ := hS
  have hrewrite : ∀ K : ℕ,
      (fun u : Fin r → I01 => (∏ j, f j (u j)) * S.prod (fun j => radI K (u j))) =
      fun u => ∏ j, f j (u j) * (if j ∈ S then radI K (u j) else 1) := by
    intro K
    funext u
    rw [← Finset.prod_ite_mem_eq S (fun j => radI K (u j))]
    rw [← Finset.prod_mul_distrib]
  rw [show (fun K : ℕ => ∫ u : Fin r → I01, (∏ j, f j (u j)) * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) =
      fun K => ∫ u : Fin r → I01, ∏ j, f j (u j) * (if j ∈ S then radI K (u j) else 1) ∂(I01Pi r) by
    funext K; rw [hrewrite K]]
  have hfactor : ∀ K, (∫ u : Fin r → I01, ∏ j, f j (u j) * (if j ∈ S then radI K (u j) else 1) ∂(I01Pi r)) =
      ∏ j, ∫ x : I01, f j x * (if j ∈ S then radI K x else 1) ∂volume := by
    intro K
    unfold I01Pi
    exact integral_fin_nat_prod_eq_prod (fun j x => f j x * (if j ∈ S then radI K x else 1))
  simp_rw [hfactor]
  have htend_factor : ∀ j : Fin r, Tendsto
      (fun K : ℕ => ∫ x : I01, f j x * (if j ∈ S then radI K x else 1) ∂volume)
      atTop (𝓝 (if j ∈ S then 0 else ∫ x : I01, f j x ∂volume)) := by
    intro j
    by_cases hj : j ∈ S
    · have hcontj : Continuous (fun x : I01 => f j x) := hcont j
      simpa [hj] using radI_annihilate ⟨f j, hcontj⟩
    · simp [hj]
  have hprod_tend := tendsto_finset_prod (Finset.univ : Finset (Fin r)) (fun j hj => htend_factor j)
  have hlim_zero : (∏ j : Fin r, (if j ∈ S then (0:ℝ) else ∫ x : I01, f j x ∂volume)) = 0 := by
    rw [Finset.prod_eq_zero (s := Finset.univ) (i := j0) (Finset.mem_univ j0)]
    simp [hj0]
  simpa [hlim_zero] using hprod_tend

/-- The submodule spanned by coordinate-product functions. -/
noncomputable def prodSpan (r : ℕ) : Submodule ℝ C((Fin r → I01), ℝ) :=
  Submodule.span ℝ (Set.range (prodCM r))

/-- Annihilation holds on the whole span of coordinate products. -/
lemma prodSpan_annihilates (r : ℕ) (S : Finset (Fin r)) (hS : S.Nonempty) :
    ∀ q ∈ prodSpan r,
    Tendsto (fun K : ℕ =>
      ∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) atTop (𝓝 0) := by
  intro q hq
  refine Submodule.span_induction
      (p := fun q _ => Tendsto (fun K : ℕ =>
        ∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) atTop (𝓝 0))
      ?hmem ?hzero ?hadd ?hsmul hq
  · intro q' hq'
    rcases hq' with ⟨f, rfl⟩
    simpa [prodCM] using product_annihilate r S hS (fun j x => f j x) (fun j => (f j).continuous)
  · simp
  · intro x y hx hy hxann hyann
    have hsum : (fun K : ℕ => ∫ u : Fin r → I01, (x + y) u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) =
        fun K => (∫ u : Fin r → I01, x u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) +
                 (∫ u : Fin r → I01, y u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) := by
      funext K
      rw [← integral_add]
      · congr 1; funext u; simp [add_mul]
      · exact integrable_radProd r S x K
      · exact integrable_radProd r S y K
    rw [hsum]
    simpa using hxann.add hyann
  · intro a x hx hxann
    have hsmul' : (fun K : ℕ => ∫ u : Fin r → I01, (a • x) u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) =
        fun K => a * (∫ u : Fin r → I01, x u * S.prod (fun j => radI K (u j)) ∂(I01Pi r)) := by
      funext K
      calc
        (∫ u : Fin r → I01, (a • x) u * S.prod (fun j => radI K (u j)) ∂I01Pi r)
            = ∫ u : Fin r → I01, a * (x u * S.prod (fun j => radI K (u j))) ∂I01Pi r := by
                congr 1; funext u; simp [smul_eq_mul]; ring
        _ = a * (∫ u : Fin r → I01, x u * S.prod (fun j => radI K (u j)) ∂I01Pi r) := by
                rw [integral_const_mul]
    rw [hsmul']
    simpa using (tendsto_const_nhds.mul hxann)

/-- Products of coordinate-product functions are again coordinate products. -/
lemma prodCM_mul (r : ℕ) (f g : Fin r → C(I01, ℝ)) :
    prodCM r f * prodCM r g = prodCM r (fun k => f k * g k) := by
  ext u
  simp [prodCM, Finset.prod_mul_distrib]

/-- prodSpan is closed under multiplication. -/
lemma prodSpan_mul_mem (r : ℕ) {x y : C((Fin r → I01), ℝ)}
    (hx : x ∈ prodSpan r) (hy : y ∈ prodSpan r) : x * y ∈ prodSpan r := by
  refine Submodule.span_induction
      (p := fun x _ => ∀ {y}, y ∈ prodSpan r → x * y ∈ prodSpan r)
      ?hmem ?hzero ?hadd ?hsmul hx hy
  · intro x' hx' y hy
    rcases hx' with ⟨f, rfl⟩
    refine Submodule.span_induction
        (p := fun y _ => prodCM r f * y ∈ prodSpan r) ?memy ?zeroy ?addy ?smuly hy
    · intro y' hy'
      rcases hy' with ⟨g, rfl⟩
      rw [prodCM_mul]
      exact Submodule.subset_span ⟨fun k => f k * g k, rfl⟩
    · simp [(prodSpan r).zero_mem]
    · intro y1 y2 hy1 hy2 ihy1 ihy2
      rw [mul_add]
      exact (prodSpan r).add_mem ihy1 ihy2
    · intro a y1 hy1 ihy1
      rw [mul_smul_comm]
      exact (prodSpan r).smul_mem a ihy1
  · intro y
    simp [(prodSpan r).zero_mem]
  · intro x1 x2 hx1 hx2 ihx1 ihx2 y hy
    rw [add_mul]
    exact (prodSpan r).add_mem (ihx1 hy) (ihx2 hy)
  · intro a x1 hx1 ihx1 y hy
    rw [smul_mul_assoc]
    exact (prodSpan r).smul_mem a (ihx1 hy)

/-- The tensor subalgebra lies inside prodSpan. -/
lemma tensorSubalg_le_prodSpan (r : ℕ) :
    (tensorSubalg r : Set C((Fin r → I01), ℝ)) ⊆ (prodSpan r : Set C((Fin r → I01), ℝ)) := by
  intro q hq
  refine Algebra.adjoin_induction (p := fun q _ => q ∈ prodSpan r) ?hmem ?halg ?hadd ?hmul hq
  · intro q' hq'
    rcases hq' with ⟨j, rfl⟩
    let g : Fin r → C(I01, ℝ) := fun k => if k = j then ⟨fun x : I01 => (x : ℝ), by fun_prop⟩ else ⟨fun _ : I01 => (1:ℝ), continuous_const⟩
    have hcg : prodCM r g = coordProj r j := by
      ext u
      simp [prodCM, g, coordProj]
      rw [Finset.prod_eq_single j]
      · simp
      · intro k hk hkj; simp [hkj]
      · intro hjnot; simp at hjnot
    rw [← hcg]
    exact Submodule.subset_span ⟨g, rfl⟩
  · intro c
    have hone : (1 : C((Fin r → I01), ℝ)) ∈ prodSpan r := by
      let g : Fin r → C(I01, ℝ) := fun _ => ⟨fun _ => 1, continuous_const⟩
      have hcg : prodCM r g = 1 := by
        ext u; simp [prodCM, g]
      rw [← hcg]
      exact Submodule.subset_span ⟨g, rfl⟩
    simpa [Algebra.smul_def] using (prodSpan r).smul_mem c hone
  · intro x y hx hy ihx ihy
    exact (prodSpan r).add_mem ihx ihy
  · intro x y hx hy ihx ihy
    exact prodSpan_mul_mem r ihx ihy

/-- Multi-dim annihilation for any continuous density q and nonempty Rademacher set. -/
theorem radI_multidim (r : ℕ) (q : C((Fin r → I01), ℝ))
    (S : Finset (Fin r)) (hS : S.Nonempty) :
    Tendsto (fun K : ℕ =>
      ∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂(I01Pi r))
      atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop]
  intro eps heps
  have hdense : (tensorSubalg r).topologicalClosure = ⊤ := tensorSubalg_dense r
  have hqmem : q ∈ ((tensorSubalg r).topologicalClosure : Set C((Fin r → I01), ℝ)) := by
    rw [hdense]; trivial
  change q ∈ closure ((tensorSubalg r : Subalgebra ℝ C((Fin r → I01), ℝ)) : Set C((Fin r → I01), ℝ)) at hqmem
  rw [Metric.mem_closure_iff] at hqmem
  obtain ⟨p, hp_mem, hp_dist⟩ := hqmem (eps/2) (by linarith)
  have hp_prodSpan : p ∈ prodSpan r := tensorSubalg_le_prodSpan r hp_mem
  have hp_ann := prodSpan_annihilates r S hS p hp_prodSpan
  rw [Metric.tendsto_atTop] at hp_ann
  obtain ⟨K0, hK0⟩ := hp_ann (eps/2) (by linarith)
  refine ⟨K0, ?_⟩
  intro K hK
  rw [Real.dist_eq, sub_zero]
  have hqint := integrable_radProd r S q K
  have hpint := integrable_radProd r S p K
  have hdiff : (∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂I01Pi r) -
        (∫ u : Fin r → I01, p u * S.prod (fun j => radI K (u j)) ∂I01Pi r) =
      ∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r := by
    calc
      (∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂I01Pi r) -
          (∫ u : Fin r → I01, p u * S.prod (fun j => radI K (u j)) ∂I01Pi r)
          = ∫ u : Fin r → I01, (q u * S.prod (fun j => radI K (u j)) -
              p u * S.prod (fun j => radI K (u j))) ∂I01Pi r :=
            (integral_sub hqint hpint).symm
      _ = ∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r := by
            congr 1; funext u; simp; ring
  have hdiff_bound : |∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r| ≤ eps/2 := by
    rw [← Real.norm_eq_abs]
    calc
      ‖∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r‖
          ≤ ∫ u : Fin r → I01, ‖(q - p) u * S.prod (fun j => radI K (u j))‖ ∂I01Pi r :=
            norm_integral_le_integral_norm _
      _ ≤ ∫ u : Fin r → I01, ‖q - p‖ ∂I01Pi r := by
            apply integral_mono_ae
            · exact (integrable_radProd r S (q - p) K).norm
            · exact integrable_const _
            · filter_upwards with u
              rw [norm_mul]
              have hrad : ‖S.prod (fun j => radI K (u j))‖ ≤ 1 := by
                calc
                  ‖S.prod (fun j => radI K (u j))‖ ≤ S.prod (fun j => ‖radI K (u j)‖) :=
                    Finset.norm_prod_le S (fun j => radI K (u j))
                  _ ≤ 1 := by
                    apply Finset.prod_le_one
                    · intro j hj; positivity
                    · intro j hj
                      rw [Real.norm_eq_abs, radI, rademacher_abs]
              calc
                ‖(q - p) u‖ * ‖S.prod (fun j => radI K (u j))‖ ≤ ‖(q - p) u‖ * 1 :=
                  mul_le_mul_of_nonneg_left hrad (norm_nonneg _)
                _ ≤ ‖q - p‖ := by
                  simpa using ContinuousMap.norm_coe_le_norm (q - p) u
      _ = ‖q - p‖ := by
            rw [integral_const]
            simp [I01Pi]
      _ ≤ eps/2 := by
            have hdist : ‖q - p‖ = dist q p := by rw [dist_eq_norm q p]
            rw [hdist]
            exact le_of_lt hp_dist
  have hpK := hK0 K hK
  rw [Real.dist_eq, sub_zero] at hpK
  calc
    |∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂I01Pi r|
        = |(∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r) +
            (∫ u : Fin r → I01, p u * S.prod (fun j => radI K (u j)) ∂I01Pi r)| := by
              rw [← hdiff]; ring_nf
    _ ≤ |∫ u : Fin r → I01, (q - p) u * S.prod (fun j => radI K (u j)) ∂I01Pi r| +
        |∫ u : Fin r → I01, p u * S.prod (fun j => radI K (u j)) ∂I01Pi r| := abs_add_le _ _
    _ < eps/2 + eps/2 := add_lt_add_of_le_of_lt hdiff_bound hpK
    _ = eps := by ring

/-- Multi-dimensional annihilation for every L¹ density on the cube. -/
theorem radI_multidim_integrable (r : ℕ) (q : (Fin r → I01) → ℝ)
    (hq : Integrable q (I01Pi r)) (S : Finset (Fin r)) (hS : S.Nonempty) :
    Tendsto (fun K : ℕ =>
      ∫ u : Fin r → I01, q u * S.prod (fun j => radI K (u j)) ∂(I01Pi r))
      atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop]
  intro eps heps
  let eps' : ℝ := eps / 3
  have heps' : 0 < eps' := by dsimp [eps']; linarith
  obtain ⟨g, hgerr, hgint⟩ := hq.exists_boundedContinuous_integral_sub_le heps'
  let p : C((Fin r → I01), ℝ) := ⟨g, g.continuous⟩
  have hpint : Integrable (fun u : Fin r → I01 => p u) (I01Pi r) := by
    simpa [p] using hgint
  have happ : ∫ u : Fin r → I01, ‖q u - p u‖ ∂(I01Pi r) ≤ eps' := by
    simpa [p] using hgerr
  have hpann := radI_multidim r p S hS
  rw [Metric.tendsto_atTop] at hpann
  obtain ⟨K₀, hK₀⟩ := hpann eps' heps'
  let R : ℕ → (Fin r → I01) → ℝ := fun K u =>
    S.prod (fun j => radI K (u j))
  have hRmeas (K : ℕ) : Measurable (R K) := by
    dsimp [R]
    exact Finset.measurable_prod S (fun j hj =>
      (radI_measurable K).comp (measurable_pi_apply j))
  have hRbound (K : ℕ) (u : Fin r → I01) : ‖R K u‖ ≤ 1 := by
    dsimp [R]
    calc
      ‖S.prod (fun j => radI K (u j))‖ ≤
          S.prod (fun j => ‖radI K (u j)‖) := Finset.norm_prod_le _ _
      _ ≤ 1 := by
          apply Finset.prod_le_one
          · intro j hj
            exact norm_nonneg _
          · intro j hj
            rw [Real.norm_eq_abs, radI, rademacher_abs]
  have hRbound_ae (K : ℕ) : ∀ᵐ u ∂(I01Pi r), ‖R K u‖ ≤ 1 :=
    Filter.Eventually.of_forall (hRbound K)
  have hdiff_int (K : ℕ) :
      Integrable (fun u => (q u - p u) * R K u) (I01Pi r) :=
    (hq.sub hpint).mul_bdd (hRmeas K).aestronglyMeasurable (hRbound_ae K)
  have hdiff_bound (K : ℕ) :
      |∫ u, (q u - p u) * R K u ∂(I01Pi r)| ≤ eps' := by
    rw [← Real.norm_eq_abs]
    calc
      ‖∫ u, (q u - p u) * R K u ∂(I01Pi r)‖ ≤
          ∫ u, ‖(q u - p u) * R K u‖ ∂(I01Pi r) := norm_integral_le_integral_norm _
      _ ≤ ∫ u, ‖q u - p u‖ ∂(I01Pi r) := by
          apply integral_mono_ae (hdiff_int K).norm (hq.sub hpint).norm
          filter_upwards with u
          rw [norm_mul]
          exact mul_le_of_le_one_right (norm_nonneg _) (hRbound K u)
      _ ≤ eps' := happ
  refine ⟨K₀, ?_⟩
  intro K hK
  rw [Real.dist_eq, sub_zero]
  have hpsmall : |∫ u, p u * R K u ∂(I01Pi r)| < eps' := by
    have h := hK₀ K hK
    rw [Real.dist_eq, sub_zero] at h
    simpa [R] using h
  have hsplit :
      (∫ u, q u * R K u ∂(I01Pi r)) =
        (∫ u, (q u - p u) * R K u ∂(I01Pi r)) +
          ∫ u, p u * R K u ∂(I01Pi r) := by
    have hfun : (fun u => q u * R K u) =
        fun u => (q u - p u) * R K u + p u * R K u := by
      funext u
      ring
    rw [hfun, integral_add (hdiff_int K) (integrable_radProd r S p K)]
  calc
    |∫ u, q u * R K u ∂(I01Pi r)| =
        |(∫ u, (q u - p u) * R K u ∂(I01Pi r)) +
          ∫ u, p u * R K u ∂(I01Pi r)| := by rw [← hsplit]
    _ ≤ |∫ u, (q u - p u) * R K u ∂(I01Pi r)| +
        |∫ u, p u * R K u ∂(I01Pi r)| := abs_add_le _ _
    _ < eps' + eps' := add_lt_add_of_le_of_lt (hdiff_bound K) hpsmall
    _ < eps := by dsimp [eps']; linarith

end YangMills
