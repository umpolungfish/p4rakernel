import Mathlib

noncomputable section

namespace Imscribing.OrbitFixedPoint98

/-!
# OrbitFixedPoint98
## The Three-Body Problem as a Two-Sided Non-Well-Founded Orbit

The unknown is the complete orbital history

    s : Body → ℤ → Vec3

The index ℤ is two-sided. Every orbital state has a predecessor
and successor, and no state is selected as the root of the system.

At each index, all three oriented relative orbits participate in
one shared gravitational field.

The physical acceleration is

    Aᵢ(s,n) = G (mᵢ S(s,n) - M sᵢ(n)/|sᵢ(n)|³)

where

    S(s,n) = Σⱼ sⱼ(n)/|sⱼ(n)|³.

The simultaneous orbital operator is

    T(s)ᵢ(n) =
      (sᵢ(n+1) + sᵢ(n-1) - h² Aᵢ(s,n))/2.

Consequently,

    T(s) = s

is equivalent to the two-sided discrete Newtonian orbit equation

    sᵢ(n+1) - 2sᵢ(n) + sᵢ(n-1) = h² Aᵢ(s,n).

The complete orbital history is the fixed-point unknown.
No body is advanced independently of the other two.
-/

/-! ## 1. Orbital index and relational state -/

abbrev Body := Fin 3
abbrev Vec3 := Fin 3 → ℝ

/-- The complete, two-sided orbital history. -/
abbrev OrbitHistory := Body → ℤ → Vec3

structure OrbitParameters where
  G : ℝ
  mass : Body → ℝ
  step : ℝ
  G_pos : 0 < G
  mass_pos : ∀ i, 0 < mass i
  step_pos : 0 < step

def totalMass (p : OrbitParameters) : ℝ :=
  p.mass 0 + p.mass 1 + p.mass 2

/-! ## 2. The two-sided non-well-founded hierarchy -/

/-- A level is supported by its predecessor and successor. -/
def OrbitIndexSupport (S : Set ℤ) : Set ℤ :=
  {n | n - 1 ∈ S ∧ n + 1 ∈ S}

/-- Greatest post-fixed-point orbital hierarchy. -/
def OrbitIndexKernel : Set ℤ :=
  ⋃₀ {S : Set ℤ | S ⊆ OrbitIndexSupport S}

/-- The complete integer hierarchy is its own support. -/
theorem orbitIndexKernel_eq_univ :
    OrbitIndexKernel = Set.univ := by
  apply Set.eq_univ_iff_forall.mpr
  intro n
  unfold OrbitIndexKernel
  apply Set.mem_sUnion.mpr
  refine ⟨Set.univ, ?_, Set.mem_univ n⟩
  intro k hk
  simp [OrbitIndexSupport]

theorem orbit_index_has_both_neighbors (n : ℤ) :
    n - 1 ∈ OrbitIndexKernel ∧
    n + 1 ∈ OrbitIndexKernel := by
  rw [orbitIndexKernel_eq_univ]
  simp

theorem orbit_index_has_predecessor (n : ℤ) :
    ∃ m : ℤ, m + 1 = n := by
  exact ⟨n - 1, by omega⟩

theorem orbit_index_has_successor (n : ℤ) :
    ∃ m : ℤ, n + 1 = m := by
  exact ⟨n + 1, rfl⟩

/-- An infinite descending orbital chain. -/
def InfiniteOrbitalDescent : Prop :=
  ∃ f : ℕ → ℤ, ∀ n, f (n + 1) = f n - 1

theorem integer_orbit_has_infinite_descent :
    InfiniteOrbitalDescent := by
  refine ⟨fun n => -(n : ℤ), ?_⟩
  intro n
  push_cast
  ring

/-! ## 3. Relational gravitational geometry -/

/-- Squared length of a relational separation. -/
def orbitNormSq (r : Vec3) : ℝ :=
  ∑ c : Fin 3, r c * r c

/-- Newton's inverse-cube kernel. -/
def orbitInverseCube (r : Vec3) : ℝ :=
  1 / (orbitNormSq r * Real.sqrt (orbitNormSq r))

/-- Shared gravitational field generated by all three orbits. -/
def sharedField (s : OrbitHistory) (n : ℤ) (c : Fin 3) : ℝ :=
  orbitInverseCube (s 0 n) * s 0 n c +
  orbitInverseCube (s 1 n) * s 1 n c +
  orbitInverseCube (s 2 n) * s 2 n c

/-- Exact symmetric relational acceleration of side i. -/
def relationalAcceleration
    (p : OrbitParameters)
    (s : OrbitHistory)
    (i : Body) (n : ℤ) (c : Fin 3) : ℝ :=
  p.G *
    (p.mass i * sharedField s n c -
      totalMass p * orbitInverseCube (s i n) * s i n c)

/-- The three relational accelerations close identically. -/
theorem relational_acceleration_sum_zero
    (p : OrbitParameters) (s : OrbitHistory)
    (n : ℤ) (c : Fin 3) :
    relationalAcceleration p s 0 n c +
    relationalAcceleration p s 1 n c +
    relationalAcceleration p s 2 n c = 0 := by
  simp [relationalAcceleration, totalMass, sharedField]
  ring

/-! ## 4. The simultaneous orbital fixed-point operator -/

/-- One coordinate of the simultaneous orbital update.

The update at n reads both n+1 and n-1 and the shared field
generated by all three relational orbits at n.
-/
def OrbitOperator
    (p : OrbitParameters)
    (s : OrbitHistory)
    (i : Body) (n : ℤ) (c : Fin 3) : ℝ :=
  (s i (n + 1) c +
    s i (n - 1) c -
    p.step ^ 2 * relationalAcceleration p s i n c) / 2

/-- The global operator acts on all three complete orbital histories
at once. -/
def OrbitTransform
    (p : OrbitParameters)
    (s : OrbitHistory) : OrbitHistory :=
  fun i n c => OrbitOperator p s i n c

/-- The actual orbital solution condition: a global fixed point. -/
def IsOrbitFixedPoint
    (p : OrbitParameters)
    (s : OrbitHistory) : Prop :=
  ∀ i n c, OrbitTransform p s i n c = s i n c

/-! ## 5. The physical equation represented by the fixed point -/

/-- The two-sided discrete Newtonian equation. -/
def IsDiscreteNewtonOrbit
    (p : OrbitParameters)
    (s : OrbitHistory) : Prop :=
  ∀ i n c,
    s i (n + 1) c -
      2 * s i n c +
      s i (n - 1) c =
      p.step ^ 2 * relationalAcceleration p s i n c

/-- The orbital fixed point is exactly the simultaneous
two-sided Newtonian orbit equation. -/
theorem orbit_fixedpoint_iff_discrete_newton
    (p : OrbitParameters) (s : OrbitHistory) :
    IsOrbitFixedPoint p s ↔ IsDiscreteNewtonOrbit p s := by
  constructor
  · intro h i n c
    have hc := h i n c
    dsimp [OrbitTransform, OrbitOperator] at hc
    nlinarith [hc]
  · intro h i n c
    dsimp [OrbitTransform, OrbitOperator]
    nlinarith [h i n c]

/-! ## 6. Relational closure is invariant under the global operator -/

/-- Closed triangular orbital geometry. -/
def OrbitClosed (s : OrbitHistory) : Prop :=
  ∀ n c,
    s 0 n c + s 1 n c + s 2 n c = 0

/-- The global simultaneous update preserves triangular closure. -/
theorem orbitTransform_preserves_closure
    (p : OrbitParameters) (s : OrbitHistory)
    (h : OrbitClosed s) :
    OrbitClosed (OrbitTransform p s) := by
  intro n c
  dsimp [OrbitClosed, OrbitTransform, OrbitOperator]
  have hp := h (n + 1) c
  have hm := h (n - 1) c
  have ha := relational_acceleration_sum_zero p s n c
  nlinarith [hp, hm, ha]

/-! ## 7. Collision-free orbital domain -/

/-- Every relational side remains nonzero throughout the orbit. -/
def OrbitCollisionFree (s : OrbitHistory) : Prop :=
  ∀ i n, 0 < orbitNormSq (s i n)

/-! ## 8. Synchronous whole-orbit iteration -/

/-- Jacobi iteration of the complete orbital organism.

Every iteration updates every body and every orbital index
from the preceding complete history.
-/
def OrbitJacobiIteration
    (p : OrbitParameters) :
    ℕ → OrbitHistory → OrbitHistory
  | 0, s => s
  | n + 1, s => OrbitTransform p (OrbitJacobiIteration p n s)

/-- Every Jacobi iterate retains relational closure. -/
theorem orbitIteration_preserves_closure
    (p : OrbitParameters) (s : OrbitHistory)
    (h : OrbitClosed s) :
    ∀ k, OrbitClosed (OrbitJacobiIteration p k s) := by
  intro k
  induction k with
  | zero =>
      exact h
  | succ k ih =>
      simpa [OrbitJacobiIteration] using
        orbitTransform_preserves_closure p
          (OrbitJacobiIteration p k s) ih

/-- Once the whole orbit is a fixed point, synchronous iteration
leaves the entire organism unchanged. -/
theorem orbitIteration_of_fixedpoint
    (p : OrbitParameters) (s : OrbitHistory)
    (h : IsOrbitFixedPoint p s) :
    ∀ k, OrbitJacobiIteration p k s = s := by
  intro k
  induction k with
  | zero =>
      rfl
  | succ k ih =>
      change OrbitTransform p
        (OrbitJacobiIteration p k s) = s
      funext i n c
      rw [ih]
      exact h i n c

/-! ## 9. Residual and finite-window operational objective -/

/-- Local defect of the discrete Newtonian orbit equation. -/
def OrbitResidual
    (p : OrbitParameters)
    (s : OrbitHistory)
    (i : Body) (n : ℤ) (c : Fin 3) : ℝ :=
  s i (n + 1) c -
    2 * s i n c +
    s i (n - 1) c -
    p.step ^ 2 * relationalAcceleration p s i n c

/-- The physical orbit equation holds exactly when every local
orbital residual vanishes. -/
theorem discrete_orbit_iff_residual_zero
    (p : OrbitParameters) (s : OrbitHistory) :
    IsDiscreteNewtonOrbit p s ↔
      ∀ i n c, OrbitResidual p s i n c = 0 := by
  constructor
  · intro h i n c
    simp [OrbitResidual, h i n c]
  · intro h i n c
    have hr := h i n c
    dsimp [OrbitResidual] at hr
    linarith

/-- Finite-window residual objective.

The window is finite, but every residual is evaluated against the
two-sided infinite orbital history, including its neighboring values.
-/
def OrbitWindowLoss
    (p : OrbitParameters)
    (s : OrbitHistory)
    (radius : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc (-(radius : ℤ)) (radius : ℤ),
    ∑ i : Body, ∑ c : Fin 3,
      (OrbitResidual p s i n c) ^ 2

/-! ## 10. The unified non-well-founded orbital organism -/

/-- A physical orbital solution is one complete two-sided
history satisfying the simultaneous fixed-point equation,
relational closure, and collision-free conditions.
-/
structure ThreeBodyOrbitOrganism89
    (p : OrbitParameters) where
  orbit : OrbitHistory
  fixed_point : IsOrbitFixedPoint p orbit
  closed : OrbitClosed orbit
  collision_free : OrbitCollisionFree orbit

/-- The organism solves the two-sided discrete Newtonian equations. -/
theorem organism89_solves_orbit_equation
    (p : OrbitParameters)
    (O : ThreeBodyOrbitOrganism89 p) :
    IsDiscreteNewtonOrbit p O.orbit :=
  (orbit_fixedpoint_iff_discrete_newton p O.orbit).mp O.fixed_point

/-- The organism's entire orbit is its own simultaneous update. -/
theorem organism89_is_self_consistent
    (p : OrbitParameters)
    (O : ThreeBodyOrbitOrganism89 p) :
    ∀ i n c, OrbitTransform p O.orbit i n c = O.orbit i n c :=
  O.fixed_point

/-- The organism is indexed over the entire two-sided hierarchy. -/
theorem organism89_has_no_initial_or_terminal_level
    (p : OrbitParameters)
    (O : ThreeBodyOrbitOrganism89 p)
    (n : ℤ) :
    (∃ m : ℤ, m + 1 = n) ∧
    (∃ m : ℤ, n + 1 = m) := by
  exact ⟨orbit_index_has_predecessor n,
    orbit_index_has_successor n⟩

/-- The central operational equivalence:
a complete non-well-founded orbital history is a solution exactly
when it is a fixed point of the simultaneous relational
Newtonian operator.
-/
theorem three_body_orbital_fixedpoint_solution
    (p : OrbitParameters) (s : OrbitHistory)
    (hclosed : OrbitClosed s)
    (hcollision : OrbitCollisionFree s) :
    IsOrbitFixedPoint p s ↔
      IsDiscreteNewtonOrbit p s ∧
      OrbitClosed s ∧
      OrbitCollisionFree s := by
  constructor
  · intro h
    exact ⟨
      (orbit_fixedpoint_iff_discrete_newton p s).mp h,
      hclosed,
      hcollision
    ⟩
  · rintro ⟨hnewton, _, _⟩
    exact (orbit_fixedpoint_iff_discrete_newton p s).mpr hnewton

end Imscribing.OrbitFixedPoint98