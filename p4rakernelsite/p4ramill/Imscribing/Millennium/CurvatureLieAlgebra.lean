import Imscribing.Millennium.TrineOperatorAlgebra

namespace Imscribing.Millennium.CurvatureLieAlgebra

/-! ## Part 1: Primitive Bit Transitions and Order Operators on Fin 16 -/

/-- Raising operator |1⟩_a⟨0| on coordinate a ∈ {0=f, 1=t, 2=F, 3=T}. -/
def EPlus (a : ℕ) : Matrix (Fin 16) (Fin 16) ℤ :=
  fun i j => if i.val = j.val + 2^a ∧ (j.val / 2^a) % 2 = 0 then 1 else 0

/-- Lowering operator |0⟩_a⟨1| on coordinate a ∈ {0=f, 1=t, 2=F, 3=T}. -/
def EMinus (a : ℕ) : Matrix (Fin 16) (Fin 16) ℤ :=
  fun i j => if j.val = i.val + 2^a ∧ (i.val / 2^a) % 2 = 0 then 1 else 0

def lieBracket {n : Type*} [Fintype n] [DecidableEq n]
    (A B : Matrix n n ℤ) : Matrix n n ℤ :=
  A * B - B * A

/-- The three directed cover operators U_i, U_t, U_c on the 16-state carrier. -/
def Ui : Matrix (Fin 16) (Fin 16) ℤ := EPlus 3 + EPlus 2 + EPlus 1 + EPlus 0
def Ut : Matrix (Fin 16) (Fin 16) ℤ := EPlus 3 + EMinus 2 + EPlus 1 + EMinus 0
def Uc : Matrix (Fin 16) (Fin 16) ℤ := EPlus 3 + EPlus 2 + EMinus 1 + EMinus 0

/-- Pairwise order-curvature commutators K_{it}, K_{tc}, K_{ci}. -/
def Kit : Matrix (Fin 16) (Fin 16) ℤ := lieBracket Ui Ut
def Ktc : Matrix (Fin 16) (Fin 16) ℤ := lieBracket Ut Uc
def Kci : Matrix (Fin 16) (Fin 16) ℤ := lieBracket Uc Ui

/-- Exact curvature closure: K_{it} + K_{tc} + K_{ci} = 0. -/
theorem curvature_closure : Kit + Ktc + Kci = 0 := by
  ext i j
  revert i j
  decide

/-! ## Part 2: 8-State A₂ Root & Cartan Algebra (Fixed T-Layer) -/

private def zVal (b : ℕ) : ℤ := if b = 1 then 1 else -1

/-- Normalized curvature weights in coordinate order (F, t, f) indexed by Fin 8. -/
def h1Weight (x : Fin 8) : ℤ :=
  let zF := zVal ((x.val / 4) % 2)
  let zt := zVal ((x.val / 2) % 2)
  let zf := zVal (x.val % 2)
  (2 * zF - zt + zf) / 2

def h2Weight (x : Fin 8) : ℤ :=
  let zF := zVal ((x.val / 4) % 2)
  let zt := zVal ((x.val / 2) % 2)
  let zf := zVal (x.val % 2)
  (-zF + 2 * zt + zf) / 2

def H1 : Matrix (Fin 8) (Fin 8) ℤ := fun i j => if i = j then h1Weight i else 0
def H2 : Matrix (Fin 8) (Fin 8) ℤ := fun i j => if i = j then h2Weight i else 0

/-- Simple positive root operator E_{α₁} = ad(e₁₂) on the 8-state T-layer. -/
def Ea1 : Matrix (Fin 8) (Fin 8) ℤ := fun i j =>
  match j.val, i.val with
  | 0, 4 => -1
  | 1, 5 => 1
  | 2, 6 => 1
  | 3, 7 => 1
  | 6, 5 => -2
  | _, _ => 0

/-- Simple positive root operator E_{α₂} = ad(e₂₃) on the 8-state T-layer. -/
def Ea2 : Matrix (Fin 8) (Fin 8) ℤ := fun i j =>
  match j.val, i.val with
  | 0, 2 => 1
  | 4, 1 => 1
  | 1, 3 => -2
  | 6, 3 => 1
  | 5, 7 => -1
  | _, _ => 0

/-- Simple negative root operator E_{-α₁} = ad(e₂₁). -/
def Em1 : Matrix (Fin 8) (Fin 8) ℤ := fun i j =>
  match j.val, i.val with
  | 1, 2 => -1
  | 4, 0 => -1
  | 5, 6 => -1
  | 6, 2 => 2
  | 7, 3 => 1
  | _, _ => 0

/-- Simple negative root operator E_{-α₂} = ad(e₃₂). -/
def Em2 : Matrix (Fin 8) (Fin 8) ℤ := fun i j =>
  match j.val, i.val with
  | 1, 4 => 2
  | 2, 0 => 1
  | 3, 1 => -1
  | 6, 4 => -1
  | 7, 5 => -1
  | _, _ => 0

/-- Composite roots generated by Lie bracket closure. -/
def Ea3 : Matrix (Fin 8) (Fin 8) ℤ := lieBracket Ea1 Ea2
def Em3 : Matrix (Fin 8) (Fin 8) ℤ := lieBracket Em2 Em1

/-- Complete Chevalley and Serre relations for sl₃ on the 8-state T-layer. -/
theorem sl3_cartan_comm : lieBracket H1 H2 = 0 := by
  ext i j; revert i j; decide

theorem sl3_cartan_pos_roots :
    lieBracket H1 Ea1 = 2 • Ea1 ∧
    lieBracket H1 Ea2 = (-1 : ℤ) • Ea2 ∧
    lieBracket H2 Ea1 = (-1 : ℤ) • Ea1 ∧
    lieBracket H2 Ea2 = 2 • Ea2 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> (ext i j; revert i j; decide)

theorem sl3_cartan_neg_roots :
    lieBracket H1 Em1 = (-2 : ℤ) • Em1 ∧
    lieBracket H1 Em2 = Em2 ∧
    lieBracket H2 Em1 = Em1 ∧
    lieBracket H2 Em2 = (-2 : ℤ) • Em2 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> (ext i j; revert i j; decide)

theorem sl3_chevalley_pairing :
    lieBracket Ea1 Em1 = H1 ∧
    lieBracket Ea2 Em2 = H2 ∧
    lieBracket Ea1 Em2 = 0 ∧
    lieBracket Ea2 Em1 = 0 ∧
    lieBracket Ea3 Em3 = H1 + H2 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> (ext i j; revert i j; decide)

theorem sl3_serre_relations :
    lieBracket Ea1 (lieBracket Ea1 Ea2) = 0 ∧
    lieBracket Ea2 (lieBracket Ea2 Ea1) = 0 ∧
    lieBracket Em1 (lieBracket Em1 Em2) = 0 ∧
    lieBracket Em2 (lieBracket Em2 Em1) = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> (ext i j; revert i j; decide)

/-! ## Part 3: Tensor Factorization V₁₆ = V_T ⊗ V₈ and sl₂ ⊕ sl₃ Decoupling -/

private def to2 (i : Fin 16) : Fin 2 := ⟨i.val / 8, by omega⟩
private def to8 (i : Fin 16) : Fin 8 := ⟨i.val % 8, by omega⟩

private def prodEquivFin16 : Fin 2 × Fin 8 ≃ Fin 16 where
  toFun p := ⟨p.1.val * 8 + p.2.val, by omega⟩
  invFun i := (⟨i.val / 8, by omega⟩, ⟨i.val % 8, by omega⟩)
  left_inv p := by
    rcases p with ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    ext <;> dsimp <;> omega
  right_inv i := by
    rcases i with ⟨k, hk⟩
    ext; dsimp; omega

def kron16 (A : Matrix (Fin 2) (Fin 2) ℤ) (B : Matrix (Fin 8) (Fin 8) ℤ) :
    Matrix (Fin 16) (Fin 16) ℤ :=
  fun i j => A (to2 i) (to2 j) * B (to8 i) (to8 j)

theorem kron16_mul (A₁ A₂ : Matrix (Fin 2) (Fin 2) ℤ) (B₁ B₂ : Matrix (Fin 8) (Fin 8) ℤ) :
    kron16 A₁ B₁ * kron16 A₂ B₂ = kron16 (A₁ * A₂) (B₁ * B₂) := by
  ext i j
  simp only [Matrix.mul_apply, kron16]
  rw [← Fintype.sum_equiv prodEquivFin16
    (fun p => (A₁ (to2 i) p.1 * B₁ (to8 i) p.2) * (A₂ p.1 (to2 j) * B₂ p.2 (to8 j)))
    (fun k => (A₁ (to2 i) (to2 k) * B₁ (to8 i) (to8 k)) * (A₂ (to2 k) (to2 j) * B₂ (to8 k) (to8 j)))
    (fun p => by
      rcases p with ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
      dsimp only
      have h1 : to2 (prodEquivFin16 (⟨a, ha⟩, ⟨b, hb⟩)) = ⟨a, ha⟩ := by
        ext; dsimp [to2, prodEquivFin16]; omega
      have h2 : to8 (prodEquivFin16 (⟨a, ha⟩, ⟨b, hb⟩)) = ⟨b, hb⟩ := by
        ext; dsimp [to8, prodEquivFin16]; omega
      rw [h1, h2])]
  rw [Fintype.sum_prod_type]
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  exact mul_mul_mul_comm _ _ _ _

theorem kron16_bracket_right (B₁ B₂ : Matrix (Fin 8) (Fin 8) ℤ) :
    lieBracket (kron16 1 B₁) (kron16 1 B₂) = kron16 1 (lieBracket B₁ B₂) := by
  simp only [lieBracket, kron16_mul, one_mul]
  ext i j
  simp only [Matrix.sub_apply, kron16]
  ring

theorem kron16_bracket_left (A₁ A₂ : Matrix (Fin 2) (Fin 2) ℤ) :
    lieBracket (kron16 A₁ 1) (kron16 A₂ 1) = kron16 (lieBracket A₁ A₂) 1 := by
  simp only [lieBracket, kron16_mul, one_mul]
  ext i j
  simp only [Matrix.sub_apply, kron16]
  ring

/-- Universal decoupling: every operator on V_T commutes with every operator on V₈. -/
theorem kron16_decouple (A : Matrix (Fin 2) (Fin 2) ℤ) (B : Matrix (Fin 8) (Fin 8) ℤ) :
    lieBracket (kron16 A 1) (kron16 1 B) = 0 := by
  simp [lieBracket, kron16_mul, one_mul, mul_one]

/-- Exact identification of the trilattice Cartan operators with I₂ ⊗ H₁ and I₂ ⊗ H₂. -/
theorem curvature_matches_cartan_lift :
    Kit - Ktc = (2 : ℤ) • kron16 1 H1 ∧
    Ktc - Kci = (2 : ℤ) • kron16 1 H2 := by
  refine ⟨?_, ?_⟩ <;> (ext i j; revert i j; decide)

/-! ## Part 4: The T-Spine sl₂ Factor and Full sl₂ ⊕ sl₃ Direct Sum on Fin 16 -/

def sp2 : Matrix (Fin 2) (Fin 2) ℤ := fun i j => if i.val = 1 ∧ j.val = 0 then 1 else 0
def sm2 : Matrix (Fin 2) (Fin 2) ℤ := fun i j => if i.val = 0 ∧ j.val = 1 then 1 else 0
def ht2 : Matrix (Fin 2) (Fin 2) ℤ := fun i j =>
  if i.val = 1 ∧ j.val = 1 then 1 else if i.val = 0 ∧ j.val = 0 then -1 else 0

def SPlus  : Matrix (Fin 16) (Fin 16) ℤ := kron16 sp2 1
def SMinus : Matrix (Fin 16) (Fin 16) ℤ := kron16 sm2 1
def HT     : Matrix (Fin 16) (Fin 16) ℤ := kron16 ht2 1

/-- The forward T-transition EPlus 3 is literally SPlus = sp2 ⊗ I₈,
    and its re-entry reversal EMinus 3 is SMinus = sm2 ⊗ I₈. -/
theorem t_spine_matches_e3 :
    EPlus 3 = SPlus ∧ EMinus 3 = SMinus := by
  refine ⟨?_, ?_⟩ <;> (ext i j; revert i j; decide)

theorem sl2_chevalley_on_fin16 :
    lieBracket SPlus SMinus = HT ∧
    lieBracket HT SPlus = 2 • SPlus ∧
    lieBracket HT SMinus = (-2 : ℤ) • SMinus := by
  have h1 : lieBracket sp2 sm2 = ht2 := by ext i j; revert i j; decide
  have h2 : lieBracket ht2 sp2 = 2 • sp2 := by ext i j; revert i j; decide
  have h3 : lieBracket ht2 sm2 = (-2 : ℤ) • sm2 := by ext i j; revert i j; decide
  refine ⟨?_, ?_, ?_⟩
  · simpa [SPlus, SMinus, HT, kron16_bracket_left] using congrArg (fun X => kron16 X 1) h1
  · rw [HT, SPlus, kron16_bracket_left, h2]
    ext i j; simp [kron16]; ring
  · rw [HT, SMinus, kron16_bracket_left, h3]
    ext i j; simp [kron16]; ring

/-- Direct-sum decoupling: all T-spine sl₂ generators commute with all A₂ generators on Fin 16. -/
theorem sl2_commutes_with_sl3 (A : Matrix (Fin 2) (Fin 2) ℤ) (B : Matrix (Fin 8) (Fin 8) ℤ) :
    lieBracket (kron16 A 1) (kron16 1 B) = 0 :=
  kron16_decouple A B

end Imscribing.Millennium.CurvatureLieAlgebra